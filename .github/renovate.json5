// Repo layer on top of the shared org preset (renovate-config:default.json5).
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    // this repo commits its bundle, so a dependency bump alone leaves dist/ stale and
    // the dist-up-to-date check blocks every merge path. Rebuild inside the update
    // branch so the same PR carries a matching bundle. `mise run build` installs as
    // locked and bundles with the bun pinned in the toolchain's mise.lock -- the same
    // bun CI builds with -- so dist/ reproduces byte-for-byte. executionMode: branch
    // runs the command once per branch after all updates (groups, lock maintenance)
    // are applied; it must match the bot's allowedCommands allow-list
    // (renovate-config:renovate-global.json5) or Renovate skips it.
    {
      matchManagers: ["bun", "npm"],
      postUpgradeTasks: {
        commands: ["mise run build"],
        installTools: { mise: {} },
        fileFilters: ["dist/**"],
        executionMode: "branch",
      },
    },
  ],
}
