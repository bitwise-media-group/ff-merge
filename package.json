{
  "name": "ff-merge",
  "version": "1.4.1",
  "description": "GitHub Action that fast-forwards an approved, green pull request into its base branch, preserving the original commit signature",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun build src/main.ts --target=node --format=esm --sourcemap=linked --outdir=dist --entry-naming=index.js --define __dirname=import.meta.dirname",
    "check": "bun ./node_modules/@biomejs/biome/bin/biome lint .",
    "check:fix": "bun ./node_modules/@biomejs/biome/bin/biome lint --write .",
    "format": "bun fmt --no-script",
    "typecheck": "bun check --no-script",
    "test": "bun test",
    "test:coverage": "bun test --coverage --reporter=junit --reporter-outfile=coverage/junit.xml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitwise-media-group/ff-merge.git"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.4.4"
  }
}
